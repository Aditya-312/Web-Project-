@model Complaint
@{
    ViewData["Title"] = "Delete complaint";
}
<div class="page-heading">
    <a asp-action="Index" class="back-link">← All complaints</a>
    <h1 class="h2 mt-3">Delete complaint</h1>
</div>
<div class="form-card">
    <div class="alert alert-warning">Are you sure you want to permanently delete this complaint? This action cannot be undone.</div>
    <h5>@Model.Title</h5>
    <p class="text-secondary">Submitted by @Model.StudentName · @Model.Category · @Model.CreatedAt.ToString("dd MMM yyyy")</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Yes, delete complaint</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
