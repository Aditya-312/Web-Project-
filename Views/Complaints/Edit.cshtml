@model Complaint
@{
    ViewData["Title"] = "Edit complaint";
}
<div class="page-heading">
    <a asp-action="Index" class="back-link">← All complaints</a>
    <h1 class="h2 mt-3">Update complaint</h1>
    <p class="text-secondary">Edit the complaint details or update its current status.</p>
</div>
<div class="form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <partial name="_ComplaintForm" model="Model" />
        <div class="mt-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                @foreach (string status in (string[])ViewBag.Statuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
            <span asp-validation-for="Status" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
